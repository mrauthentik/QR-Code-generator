# -----------------------------------------------------------------------------
# Dynamic QR Code Platform Environment Configuration
# -----------------------------------------------------------------------------

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Public Supabase URL (Used by both client and server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon Key (Public, safe for client-side queries with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (SERVER-ONLY, bypasses RLS for background workers and cron)
# NEVER expose this key to client-side code or public repositories!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# Security & Telemetry Secrets
# -----------------------------------------------------------------------------
# Secret key used to generate privacy-preserving daily visitor HMAC hashes.
# Minimum 32 random characters.
VISITOR_HASH_SECRET="change-this-to-a-very-long-secret-key-at-least-32-chars-long"

# Secret required to trigger the scheduled aggregation endpoint via Cron
CRON_SECRET="your-secure-random-cron-secret-token"

# -----------------------------------------------------------------------------
# Optional: Upstash Redis (Cache & Rate Limiting)
# -----------------------------------------------------------------------------
# If omitted or left blank, the application will transparently fall back to
# the in-memory cache and local token bucket.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
